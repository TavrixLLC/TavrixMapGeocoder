# ───────────────────────────────────────────────────────────────
# TavrixMap Geocoder — Environment Variables
# ───────────────────────────────────────────────────────────────

# PostGIS connection (worker only — read-only SELECT queries)
POSTGIS_HOST=map-data-pipeline-postgis-1
POSTGIS_PORT=5432
POSTGIS_DB=gis
POSTGIS_USER=pelias_readonly
POSTGIS_PASSWORD=change_me_readonly_password
POSTGIS_DOCKER_NETWORK=map-data-pipeline_map-data

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
PELIAS_INDEX_ALIAS=pelias
ES_HEAP_SIZE=4g
PELIAS_INDEX_SHARDS=3
PELIAS_INDEX_REPLICAS=0
ES_EXPECTED_REPLICAS=0

# API server
PELIAS_API_PORT=4000
PELIAS_API_URL=http://pelias-api:4000

# ── Query mode ──────────────────────────────────────────────────
# pelias   = Proxy all search/autocomplete/reverse to upstream Pelias API
# direct_es = Use internal ES query builders (new ranking/structured/dedup)
# hybrid   = Try direct_es first, fallback to pelias on error (default)
GEOCODER_QUERY_MODE=hybrid

# ── Security ────────────────────────────────────────────────────
# Token for worker endpoints and debug/explain access
WORKER_INTERNAL_TOKEN=
INTERNAL_TOKEN=

# ── Language ────────────────────────────────────────────────────
DEFAULT_LANG=ar
DEFAULT_FALLBACK_LANG=en
SUPPORTED_LANGUAGES=ar,en,ku,ckb

# ── Result limits ───────────────────────────────────────────────
MAX_SIZE=40
DEFAULT_SIZE=10
MAX_BATCH_SIZE=100
SEARCH_CACHE_TTL_MS=5000
SEARCH_CACHE_MAX_ENTRIES=1000
CATEGORIES_CACHE_TTL_MS=300000
CATEGORIES_CACHE_MAX_ENTRIES=100
INDEX_STATS_CACHE_TTL_MS=30000
INDEX_STATS_CACHE_MAX_ENTRIES=20

# ── Input limits ────────────────────────────────────────────────
MAX_TEXT_LENGTH=256
MAX_STRUCTURED_FIELD_LENGTH=128
MAX_NEARBY_RADIUS_METERS=50000
DEFAULT_NEARBY_RADIUS_METERS=1000

# ── Timeouts ────────────────────────────────────────────────────
ES_REQUEST_TIMEOUT_MS=3000
API_REQUEST_TIMEOUT_MS=5000

# ── Debug/Internal endpoints ────────────────────────────────────
DEBUG_ENDPOINTS_ENABLED=true
EXPLAIN_ENDPOINT_ENABLED=true

# ── Logging ─────────────────────────────────────────────────────
# Set to true to include search text in structured logs
LOG_SEARCH_TEXT=false

# ── Config paths ────────────────────────────────────────────────
CATEGORIES_CONFIG_PATH=
CATEGORY_TAXONOMY_PATH=/app/config/category-taxonomy.json
CATEGORY_LABELS_PATH=/app/generated/category-labels.wikidata.json
RANKING_CONFIG_PATH=
SYNONYMS_DIR=

# ── Worker ──────────────────────────────────────────────────────
WORKER_STALE_THRESHOLD_SECONDS=86400
SYNC_CONFIG_PATH=/app/config/pelias-postgis-readonly-sync.json
SYNC_STATE_BACKEND=sqlite
SYNC_STATE_PATH=/app/state/sync-state.sqlite
SYNC_STATE_SNAPSHOT_PATH=/app/state/sync-state.json
HEALTH_PORT=9090

# ── Swagger ─────────────────────────────────────────────────────
SWAGGER_PORT=8088
